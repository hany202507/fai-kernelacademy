#!/bin/sh
# ─────────────────────────────────────────────────────────────
# 실데이터 반입 차단 — 커밋 직전 스테이징된 내용을 스캔한다.
#
# 이 저장소는 공개 예정이다. 한 번 커밋되면 나중에 지워도 git 히스토리에
# 영구히 남는다. 그래서 커밋 시점에 막는다.
#
# 활성화 (클론마다 한 번):
#   git config core.hooksPath .githooks
#
# 오탐일 때만:
#   git commit --no-verify
#
# 한계: 텍스트만 본다. docx·xlsx·pdf 안의 실데이터는 잡지 못한다.
#       바이너리 첨부는 사람이 직접 확인해야 한다.
# ─────────────────────────────────────────────────────────────
#
# 패턴을 변수 목록으로 순회하지 않는다 — 인용 없는 변수는 단어 분할·글롭을
# 거쳐 정규식이 조각난다. 실제로 그렇게 짰다가 훅이 조용히 통과하는 사고를
# 냈다. 검사마다 명시적으로 쓴다.

# 추가된 줄(+)만 본다. 삭제하는 커밋을 막으면 정리를 못 한다.
#
# 주의: 두 번째 grep 은 BRE 다. BRE 에서 '+' 는 평범한 문자이므로 그대로 쓴다.
# '\+' 로 쓰면 GNU 확장의 "1회 이상" 수량자가 되어 헤더뿐 아니라 내용 줄까지
# 지워버린다 — 실제로 그렇게 짰다가 훅이 아무것도 못 잡는 사고를 냈다.
added=$(git diff --cached --unified=0 --no-color | grep -E '^\+' | grep -v '^+++')

fail=0

report() {
    if [ "$fail" -eq 0 ]; then
        echo ""
        echo "커밋을 멈췄다 — 실데이터로 보이는 패턴이 있다."
        echo "이 저장소는 공개 예정이고, 커밋된 것은 히스토리에 영구히 남는다."
        echo ""
    fi
    echo "  [$1]"
    printf '%s\n' "$2" | head -5 | sed 's/^/    /'
    echo ""
    fail=1
}

# 주민등록번호 — 6자리 + 성별(1~4) + 6자리
hits=$(printf '%s\n' "$added" | grep -E '[0-9]{6}-[1-4][0-9]{6}')
[ -n "$hits" ] && report "주민등록번호" "$hits"

# 사업자등록번호 — 3-2-5
hits=$(printf '%s\n' "$added" | grep -E '[0-9]{3}-[0-9]{2}-[0-9]{5}')
[ -n "$hits" ] && report "사업자등록번호" "$hits"

# 카드번호 — 16자리, 4자리씩 하이픈 또는 공백 구분
hits=$(printf '%s\n' "$added" | grep -E '[0-9]{4}[-  ][0-9]{4}[-  ][0-9]{4}[-  ][0-9]{4}')
[ -n "$hits" ] && report "카드번호" "$hits"

# 실습 데이터는 가상 회사로만 — 흔한 실수를 파일명에서 짚어준다
#
# core.quotepath=false 가 필요하다. 기본값에서는 git 이 한글 경로를
# "\354\240\234..." 같은 8진수 이스케이프로 내보내서 한글 패턴이 매칭되지 않는다.
hits=$(git -c core.quotepath=false diff --cached --name-only |
       grep -E '실데이터|real_data|고객사|클라이언트')
if [ -n "$hits" ]; then
    report "파일명" "$hits"
    echo "    실습 데이터는 canon/10_예시실습/ 의 가상 회사(메종블룸)를 쓴다."
    echo ""
fi

if [ "$fail" -ne 0 ]; then
    echo "조치:"
    echo "  1) 해당 값을 가상 데이터로 바꾼다 (canon/10_예시실습/ 참조)"
    echo "  2) 오탐이면: git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
